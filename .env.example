# Copia este archivo como .env y rellena los valores. Nunca subas .env al repositorio.
# OJO: todo lo que empieza por EXPO_PUBLIC_ acaba dentro de la app y cualquiera puede leerlo.
# Aquí NUNCA van claves secretas (ni la service_role de Supabase ni claves de proveedores de IA).

# Modo de IA: mock (por defecto, sin IA real) | ollama (solo desarrollo, Sprint 6) | gateway (Sprint 7)
EXPO_PUBLIC_AI_MODE=mock

# Ollama en el PC de sobremesa, por la red local (Sprint 6). Desde el emulador del mismo PC: http://10.0.2.2:11434
EXPO_PUBLIC_OLLAMA_URL=

# Supabase (Sprint 7): URL del proyecto y clave pública (anon/publishable), protegida por RLS.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
