{
  "name": "classence",
  "version": "0.0.1",
  "description": "Classence: app móvil de estudio asistida por IA.",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "lint": "expo lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test"
  },
  "jest": {
    "preset": "jest-expo"
  },
  "dependencies": {
    "expo": "~58.0.16",
    "expo-constants": "~58.0.12",
    "expo-font": "~58.0.9",
    "expo-linking": "~58.0.13",
    "expo-router": "~58.0.24",
    "expo-splash-screen": "~58.0.10",
    "expo-status-bar": "~58.0.3",
    "expo-system-ui": "~58.0.6",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.88.0",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.11",
    "prettier": "^3.9.10",
    "test-renderer": "^1.3.1",
    "typescript": "~6.0.3"
  }
}
